# Copy to .env for local development. On Vercel, set the same names under
# Project Settings > Environment Variables.

# The linked Google Sheet, as copied from the address bar while the response
# tab is open. Share it with "Anyone with the link" as Viewer.
SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit?gid=0#gid=0

# The Google Form's link: the "Send" link, a forms.gle short link, or the
# address of the page where people answer.
FORM_URL=https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform

# Optional. When set, the attendee list asks for this key.
DASHBOARD_KEY=
